{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1000x Engineer Run Receipt v2",
  "type": "object",
  "required": ["schema_version", "receipt_id", "status", "created_at", "spec", "scope", "repository", "environment", "requirements", "graders", "artifacts", "residual_risks", "omitted_checks"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_id": {"type": "string", "pattern": "^receipt-[a-f0-9]{32}$"},
    "status": {"enum": ["VERIFIED", "FAILED", "INSUFFICIENT_EVIDENCE", "ABORTED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "spec": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "required": ["root", "commit", "branch", "dirty"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["python", "platform"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "grader_ids", "mandatory", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
          "description": {"type": "string", "minLength": 1},
          "grader_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"}},
          "mandatory": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL", "ABORTED"]}
        },
        "additionalProperties": false
      }
    },
    "graders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "argv", "required", "status", "returncode", "started_at", "finished_at", "duration_seconds", "log", "log_sha256", "preview"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL", "ABORTED"]},
          "returncode": {"type": "integer"},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "log": {"type": "string", "pattern": "^(?:.+/)?\\.evidence/logs/[a-f0-9]{16}\\.log$"},
          "log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "preview": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "omitted_checks": {"type": "array", "items": {"type": "string"}},
    "contract": {
      "type": "object",
      "required": ["path", "sha256", "scope", "authority", "budget"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope": {
          "type": "object",
          "required": ["included", "excluded", "frozen"],
          "properties": {
            "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "frozen": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": ["read", "edit", "test", "network", "credentials", "commit", "merge", "deploy"],
          "properties": {
            "read": {"type": "boolean"}, "edit": {"type": "boolean"}, "test": {"type": "boolean"}, "network": {"type": "boolean"},
            "credentials": {"type": "boolean"}, "commit": {"type": "boolean"}, "merge": {"type": "boolean"}, "deploy": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["max_iterations", "max_parallel_workers", "max_wall_seconds"],
          "properties": {
            "max_iterations": {"type": "integer", "minimum": 1},
            "max_parallel_workers": {"type": "integer", "minimum": 1},
            "max_wall_seconds": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
