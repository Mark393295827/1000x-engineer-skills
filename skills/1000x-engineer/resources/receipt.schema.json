{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "receipt_id", "status", "repository", "environment", "graders", "artifacts", "residual_risks", "omitted_checks"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"enum": ["VERIFIED", "FAILED", "INSUFFICIENT_EVIDENCE", "ABORTED"]},
    "repository": {"type": "object", "required": ["root", "commit", "branch", "dirty"]},
    "graders": {"type": "array"},
    "artifacts": {"type": "array"},
    "residual_risks": {"type": "array"},
    "omitted_checks": {"type": "array"}
  },
  "additionalProperties": true
}
